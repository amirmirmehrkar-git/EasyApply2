<!DOCTYPE html>
<html ng-controller="masterController as vm" ng-init="vm.initializeController()" ng-app="myapp" lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Easy Apply</title>

    <link rel="manifest" href="/manifest.json">

    <link rel="stylesheet" href="/css/myStyles.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/toastr.min.css" asp-append-version="true" />
    <link href="/css/ng-table.min.css" rel="stylesheet">
    <link href="/css/ADM-dateTimePicker.min.css" rel="stylesheet">
    <link href="/css/isteven-multi-select.css" rel="stylesheet">
    <link href="/css/bootstrap-rtl.min.css" rel="stylesheet">
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"> *@

    <link href="/css/tabler-icons.css" rel="stylesheet" />

    <link rel="stylesheet" href="css/myDesign.css">
    <link rel="stylesheet" href="css/myMenu.css">

</head>
<body>

    <span us-spinner="{radius:30, width:8, length: 16}">
    </span>
    <div id="loaderContainer" ng-show="spinnerActive">
        <div class="loaderLogo">
            <div class="loader">
            </div>
        </div>
    </div>

    <header style="padding-left:20px!important;padding-right:20px" class="site-header">

        <a class="brand">
            <i id="btnMenu" style="display:none!important" onclick="toggleMenu()" class="d-flex ti ti-menu-2"></i>
            <div class="logo-mark">EA</div>
            <div class="logo-all">
                <div class="step-title" style="margin-bottom:5px;font-weight:800">Easy Actions</div>
                <div style="margin-bottom:12px;font-weight:400;font-size:10px">Your AI career co-pilot</div>
            </div>
        </a>

        <nav class="top-nav" role="navigation" aria-label="Main Navigation">
            <a class="box3" href="#features">Features</a>
            <a class="box3" href="#platforms">Platforms</a>
            <a class="box3 btn ghost" href="#pricing">Pricing</a>
            <a class="box3 btn primary" href="#!/login">Get Started</a>
        </nav>
    </header>

    <div class="col-12">
        @RenderBody()
    </div>

    <footer class="site-footer" role="contentinfo">
        <div style="text-align:center">
            <div class="step-title" style="margin-bottom:5px;font-weight:800">Easy Actions</div>
            <div style="margin-bottom:12px;font-weight:400;font-size:10px">Your AI career co-pilot</div>
            <p class="small">© 2024 Easy Actions. All rights reserved. Made with ❤️ for ambitious professionals.</p>
            <div style="margin-top:12px;display:flex;gap:14px;justify-content:center">
                <a href="#" style="color:var(--muted);text-decoration:none;font-weight:700">Privacy</a>
                <a href="#" style="color:var(--muted);text-decoration:none;font-weight:700">Terms</a>
                <a href="#" style="color:var(--muted);text-decoration:none;font-weight:700">Contact</a>
            </div>
        </div>
    </footer>

    <div id="sidebar" ng-controller="profileController as vm" ng-init="vm.initializeController()">
        <div class="sidebar-header">
            <h3>Easy Actions</h3>
            <span class="subtitle">AI Co-pilot</span>
            <button class="close-btn" onclick="toggleMenu()">×</button>
        </div>

        <div class="user-info">
            <div>
                <img ng-if="vm.UserImageName === 'undefined'" class="rounded-circle"
                     src="/images/emptyImage.png" />
                <img ng-if="vm.UserImageName != 'undefined'" class="rounded-circle"
                     ng-src="{{$root.domain}}/Content/Images/ProfileImages/{{vm.UserImageName}}" />
            </div>
            <div>
                <div class="user-name">{{vm.UserFullName}}</div>
                <div class="user-email">{{vm.UserEmail}}</div>
                <div class="user-email">{{vm.WalletAmount}}$</div>
                @* <span class="plan">free Plan</span> *@
            </div>
        </div>

        <ul ng-if="vm.UserRole == 'User'" class="menu-list">
            <li style="padding-left:10px" ng-class="{'selectSection':$root.selectedDashboard}"
                ng-click="vm.goTo('/user/dashboard')"><i class="ti ti-home"></i> Home</li>

            @**@
            <li style="padding-left:10px" ng-click="vm.showSubmenu = !vm.showSubmenu">
                <i class="ti ti-calendar"></i>
                Profile
                <i class="arrow ti ti-chevron-down"></i>
            </li>

            <li ng-class="{'selectSection':$root.selectedSkills}"
                ng-click="vm.goTo('/user/skills')" ng-if="vm.showSubmenu" class="my_submenu">
                Skills
            </li>
            <li ng-class="{'selectSection':$root.selectedExperiences}"
                ng-click="vm.goTo('/user/experiences')" ng-if="vm.showSubmenu" class="my_submenu">
                Experiences
            </li>
            <li ng-class="{'selectSection':$root.selectedEducations}"
                ng-click="vm.goTo('/user/educations')" ng-if="vm.showSubmenu" class="my_submenu">
                Educations
            </li>
            <li ng-class="{'selectSection':$root.selectedCertificate}"
                ng-click="vm.goTo('/user/certificates')" ng-if="vm.showSubmenu" class="my_submenu">
                Certificates
            </li>
            <li ng-class="{'selectSection':$root.selectedDocuments}"
                ng-click="vm.goTo('/user/documents')" ng-if="vm.showSubmenu" class="my_submenu">
                Documents
            </li>
            @**@

            <li style="padding-left:10px" ng-class="{'selectSection':$root.selectedJobTracker}"
                ng-click="vm.goTo('/user/jobTracker')"><i class="ti ti-calendar"></i> Job Tracker</li>
            <li style="padding-left:10px" ng-class="{'selectSection':$root.selectedTicket}"
                ng-click="vm.goTo('/user/tickets')"><i class="ti ti-headset"></i> Tickets</li>
            <li style="padding-left:10px" ng-class="{'selectSection':$root.selectedTransactions}"
                ng-click="vm.goTo('/user/transactions')"><i class="ti ti-list"></i> Transactions</li>
            <li style="padding-left:10px" ng-class="{'selectSection':$root.selectedSetting}"
                ng-click="vm.goTo('/user/setting')"><i class="ti ti-settings"></i> Settings</li>
        </ul>

        <ul ng-if="vm.UserRole == 'Admin'" class="menu-list">
            <li ng-click="vm.goTo('/admin/dashboard')"><i class="ti ti-home"></i> Home</li>
            <li ng-click="vm.goTo('/admin/users')"><i class="ti ti-calendar"></i> Users</li>
            <li ng-click="vm.goTo('/admin/tickets')"><i class="ti ti-settings"></i> Tickets</li>
        </ul>

        <div class="logout-section">
            <a href="@Url.Action("logoff", "account", new { area = "" })" class="col-md-12 logout-btn"><i class="ti ti-logout"></i> Logout</a>
        </div>
    </div>

    <style>
        /* شناور پایین راست */
        .chat-icon {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #ffb13d, #ff9a00);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            cursor: pointer;
            transition: transform 0.3s ease;
            z-index: 999;
        }

            .chat-icon:hover {
                transform: scale(1.1);
            }

        /* پنجره چت */
        .chat-box {
            position: fixed;
            bottom: 100px;
            right: 25px;
            width: 380px;
            height: 500px;
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 1000;
        }

        .chat-header {
            background: linear-gradient(90deg, #ffa51c, #ffb94a);
            padding: 12px 15px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .chat-header h3 {
                margin: 0;
                font-size: 16px;
                font-weight: 600;
            }

            .chat-header small {
                font-size: 12px;
                color: rgba(255,255,255,0.9);
            }

        .chat-content {
            flex: 1;
            background: #fffaf3;
            padding: 15px;
            overflow-y: auto;
        }

        .bot-message {
            background: #fff;
            border: 1px solid #ffe2a6;
            border-radius: 10px;
            padding: 10px;
            margin-bottom: 10px;
            color: #444;
        }

        .chat-footer {
            background: #fff;
            border-top: 1px solid #ddd;
            padding: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .chat-footer input {
                flex: 1;
                border: none;
                outline: none;
                padding: 8px 12px;
                border-radius: 20px;
                background: #f5f5f5;
                font-size: 14px;
            }

            .chat-footer button {
                background: linear-gradient(135deg, #ffb13d, #ff9a00);
                border: none;
                color: white;
                border-radius: 50%;
                width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
            }

        .quick-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }

            .quick-actions button {
                background: #fff;
                border: 1px solid #ffce73;
                border-radius: 8px;
                padding: 5px 10px;
                font-size: 13px;
                cursor: pointer;
                color: #b37400;
                transition: background 0.3s;
            }

                .quick-actions button:hover {
                    background: #ffebc2;
                }
    </style>

    <div class="chat-icon" id="chatIcon">💬</div>

    <div class="chat-box" id="chatBox">
        <div class="chat-header">
            <div>
                <h3>Jobby - AI Career Co-pilot</h3>
                <small>Easy Actions Help Center</small>
            </div>
            <span style="cursor:pointer;" onclick="toggleChat()">✖</span>
        </div>

        <div class="chat-content" id="chatContent">
            <div class="bot-message">
                Hello! I'm Jobby, your AI career co-pilot! 🚀 I can help you in any language
                with resume uploads, job applications, cover letters, and navigating
                the entire Easy Actions platform. What would you like to know?
            </div>

            <div class="quick-actions">
                <button>Start Visual Tutorial</button>
                <button>Upload Resume</button>
                <button>Job Matching</button>
            </div>
        </div>

        <div class="chat-footer">
            <input type="text" placeholder="Ask Jobby anything about Easy Actions..." />
            <button>➤</button>
        </div>
    </div>

    <script>
        const chatIcon = document.getElementById("chatIcon");
        const chatBox = document.getElementById("chatBox");

        chatIcon.addEventListener("click", () => {
          chatBox.style.display = chatBox.style.display === "flex" ? "none" : "flex";
        });

        function toggleChat() {
          chatBox.style.display = "none";
        }
    </script>


    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/toastr.min.js"></script>
    <script src="/js/myJavaScripts.js"></script>
    <script src="/js/angularjs/angular.js"></script>
    <script src="/js/angularjs/angular-route.js"></script>
    <script src="/js/ng-table.min.js"></script>
    <script src="/js/ngFileUpload.js"></script>
    <script src="/js/angular-loading-spinner.js"></script>
    <script src="/js/ADM-dateTimePicker.min.js"></script>
    <script src="/js/fullcalendar-Jalaali/moment.min.js"></script>
    <script src="/js/moment-timezone.min.js"></script>
    <script src="/js/fullcalendar-Jalaali/moment-jalaali.js"></script>
    <script src="/js/fullcalendar-Jalaali/fullcalendar.min.js"></script>
    <script src="/js/fullcalendar-Jalaali/local/fa.js"></script>
    <script src="/js/ng-intl-tel-input/intlTelInput.js"></script>
    <script src="/js/ng-intl-tel-input/utils.js"></script>
    <script src="/js/ng-intl-tel-input/ng-intl-tel-input.js"></script>
    <script src="/js/isteven-multi-select.js"></script>

    <script src="/angularjs/controllers/masterController.js"></script>
    <script src="/angularjs/services/ajaxService.js"></script>
    <script src="/angularjs/services/profileService.js"></script>
    <script src="/angularjs/controllers/routing.js"></script>
    <script src="/angularjs/services/enums.js"></script>
    <script src="/angularjs/controllers/dashboardController.js"></script>
    <script src="/angularjs/controllers/userController.js"></script>
    <script src="/angularjs/controllers/ticketController.js"></script>
    <script src="/angularjs/controllers/profileController.js"></script>
    <script src="/angularjs/controllers/skillController.js"></script>
    <script src="/angularjs/controllers/experienceController.js"></script>
    <script src="/angularjs/controllers/educationController.js"></script>
    <script src="/angularjs/controllers/certificateController.js"></script>
    <script src="/angularjs/controllers/documentController.js"></script>
    <script src="/angularjs/controllers/suggestController.js"></script>
    <script src="/angularjs/controllers/transactionController.js"></script>

</body>
</html>
